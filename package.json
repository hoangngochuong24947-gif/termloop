{
  "name": "termloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-first, local-first terminology memorization. 一份由 Agent 研究维护、由人复习确认的术语资产。",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/cli/index.ts serve",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/cli/index.ts serve",
    "cli": "tsx src/cli/index.ts",
    "seed": "tsx src/cli/index.ts import data/seed/termlist-sus2-261.tsv",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "pnpm build && pnpm start"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoangngochuong24947-gif/termloop.git"
  },
  "keywords": [
    "terminology",
    "spaced-repetition",
    "fsrs",
    "sqlite",
    "agent",
    "local-first",
    "mlip"
  ]
}
